# Copy to backend/.env and fill in. Never commit backend/.env.

# Meta Model API key (starts with LLM_). Create it at https://dev.meta.ai/api-keys/
MODEL_API_KEY=

# Materials Project API key (free). Create it at https://next-gen.materialsproject.org/api
MP_API_KEY=

# OpenAlex API key (free, optional). Without it, literature search shares a small
# daily budget per IP address. Create it at https://openalex.org/settings/api
OPENALEX_API_KEY=

# Optional overrides
# MUSE_MODEL=muse-spark-1.3
# CORS_ORIGINS=["http://localhost:3000"]
