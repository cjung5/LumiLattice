# Copy to backend/.env and fill in. Never commit backend/.env.

# Meta Model API key (starts with LLM_). Create it at https://dev.meta.ai/api-keys/
MODEL_API_KEY=

# Materials Project API key (free). Create it at https://next-gen.materialsproject.org/api
MP_API_KEY=

# OpenAlex API key (free, optional). Without it, literature search shares a small
# daily budget per IP address. Create it at https://openalex.org/settings/api
OPENALEX_API_KEY=

# Semantic Scholar API key (free, optional). Without it, searches are often rate-limited.
# Request one at https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=

# Hosted Postgres URL (Railway in production). Without it, candidates are kept in memory only.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Visitor counts by country: set the same value here and in the frontend's VISIT_SECRET in
# production, so that only the frontend server can add to the counts.
# VISIT_SECRET=

# Private mode (GitHub sign-in): set the same value here and in the frontend's AUTH_SECRET.
# Make it with: openssl rand -hex 32. Unset: nobody can sign in, and only public mode is available.
# AUTH_SECRET=

# Optional overrides
# MUSE_MODEL=muse-spark-1.3
# Production only: send Muse Spark calls through the frontend server (see README, Deploy).
# MODEL_API_BASE_URL=https://your-site.vercel.app/api/meta
# CORS_ORIGINS=["http://localhost:3000"]
