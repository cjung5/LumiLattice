# URL of the FastAPI backend (Railway URL in production)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server only, not public. The same value as the backend's VISIT_SECRET (production).
# VISIT_SECRET=

# Server only, not public. Production: the Meta key for the /api/meta route (see README, Deploy).
# MODEL_API_KEY=

# Server only, not public. Private mode: all three, or the site offers only public mode.
# AUTH_SECRET is the same value as the backend's. Make it with: openssl rand -hex 32
# AUTH_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
